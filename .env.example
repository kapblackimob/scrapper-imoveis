# Token do seu bot no telegram
TELEGRAM_BOT_TOKEN=

# ID do seu chat no telegram. Crie um chat e adicione o bot.
TELEGRAM_BOT_CHATID=

# Uma chave qualquer para gerar um id unico baseado nas informações principais do imovel.
PRIVATE_KEY=

# Link do seu banco de dados na aws ou local
# DATABASE_URL="file:./dev.db"
DATABASE_URL=

# Chave exigida (header x-api-key) nas operações protegidas do GraphQL: find, removeAll, mutations
API_KEY=

# WhatsApp via Evolution API (opcional — sem estas envs o canal fica desativado)
# URL da Evolution API (interna do EasyPanel ou pública)
EVOLUTION_API_URL=
# apikey global da Evolution API
EVOLUTION_API_KEY=
# Nome da instância conectada ao WhatsApp
EVOLUTION_INSTANCE=
# Número (5512999999999) ou id de grupo (xxxxx@g.us) que recebe os avisos
WHATSAPP_NUMBER=
