// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {

  // Usado para desenvolvimento local
  // provider = "sqlite"
  // Usado para desenvolvimento em produção
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

model Post {
  id          String  @id @default(uuid())
  title       String
  text        String
  isPublished Boolean @default(false)
}

model Imovel {
  id          String  @id @default(uuid())
  title       String @db.Text
  slug        String @db.Text
  url         String @db.Text // Link do imovel
  description String @db.Text
  amount      Float // Valor do imovel
  websiteId  String
  website    Website @relation(fields: [websiteId], references: [id])

  type        String? // Tipo do imovelTerreno, apartamento, casa
  image       String? // Imagem do imovel
  size        String? // Tamanho em metros quadrados
  status      String? // Status atual do imovel (extrajudicial, etc)

  city        String? // Cidade extraida do titulo (quando disponivel)
  state       String? // UF
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt // Nulo em registros anteriores a esta coluna (sentinela de legado)
  notifiedAt  DateTime? // Nulo = aviso no Telegram ainda pendente
  priceHistory PriceHistory[]
}

model PriceHistory {
  id         String   @id @default(uuid())
  imovelId   String
  imovel     Imovel   @relation(fields: [imovelId], references: [id])
  amount     Float
  capturedAt DateTime @default(now())
}

model Website {
  id         String  @id @default(uuid())
  name       String
  baseUrl    String
  slug       String
  isActive   Boolean @default(true)
  pages      Page[]
  imoveis    Imovel[]
}

model Page {
  id         String  @id @default(uuid())
  relativeUrl       String
  website    Website @relation(fields: [websiteId],references: [id])
  websiteId  String
}
